# Mirrors the rules in _headers (Cloudflare/Netlify) so every host behaves alike.
#
# nginx gotcha: add_header in a location block DISCARDS every add_header
# inherited from the server block. So the security headers live here once, at
# server level, and per-file caching uses `expires`, which is a separate
# directive and does not trigger that inheritance reset.

server {
    listen      ${PORT};
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options   "nosniff" always;
    add_header X-Frame-Options          "DENY" always;
    add_header Referrer-Policy          "no-referrer" always;
    add_header Permissions-Policy       "geolocation=(), microphone=(), camera=(), payment=(), usb=()" always;
    add_header Content-Security-Policy  "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://api.dexscreener.com https://api.llama.fi https://solana-rpc.publicnode.com https://joell-lsu6ge-fast-mainnet.helius-rpc.com https://lite.chain.opentensor.ai; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;

    gzip              on;
    gzip_vary         on;
    gzip_min_length   512;
    gzip_types        text/plain text/css application/javascript application/json image/svg+xml application/xml;

    # The registry is the one file that must not go stale behind a cache.
    location = /pairs.json { expires 1m;  }
    # soltao.xyz opens the stake page; the board lives at /board/. index.html is the same hop for hosts
    # that cannot redirect.
    location = /            { return 302 /stake/$is_args$args; }
    location = /index.html  { expires 5m; }
    location = /board       { return 301 /board/$is_args$args; }
    location = /board/      { expires 5m; try_files /board/index.html =404; }

    # The stake page's HTML names its script by content hash (stake.js?v=<hash>), so the HTML must stay
    # fresh and the script can be kept for good: a new build is always a new URL.
    location = /stake/          { expires 5m; try_files /stake/index.html =404; }
    location = /stake/stake.js  { expires 1y; }
    location = /stake/return.js { expires 1y; }

    location ~* \.(css|js)$        { expires 1h; }
    location ~* \.(png|svg|ico)$   { expires 1d; }

    location / {
        try_files $uri $uri/ =404;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
